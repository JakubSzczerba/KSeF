{% extends 'base.html.twig' %}

{% block title %}KSeF UI{% endblock %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=Manrope:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/ui/dashboard.css">
{% endblock %}

{% block body %}
    <div
        id="ksef-react-root"
        data-bootstrap="{{ bootstrap|json_encode|e('html_attr') }}"
    ></div>
{% endblock %}

{% block javascripts %}
    <script type="module" src="/ui/react-dashboard.js"></script>
{% endblock %}
